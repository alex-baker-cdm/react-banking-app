{
  "name": "wf-online-banking",
  "version": "0.1.0",
  "private": true,
  "description": "Wells Fargo-style online banking demo: Angular UI + Express API with Devin auto-triage",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "serve": "node server/index.js",
    "test": "ng test",
    "test:server": "node --test server/test/*.test.js",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "eslint": "eslint ./src",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write ."
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@sentry/angular": "^11.8.0",
    "express": "^4.22.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.28",
    "@angular/cli": "^21.2.28",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "angular-eslint": "^21.4.0",
    "eslint": "^9.39.1",
    "eslint-plugin-prettier": "^5.5.4",
    "jsdom": "^28.0.0",
    "prettier": "^3.7.4",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.0.8"
  }
}
